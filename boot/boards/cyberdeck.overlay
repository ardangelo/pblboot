/ {
	chosen {
		/* we are the bootloader */
		zephyr,code-partition = &boot_partition;

		/* fixed internal firmware image */
		pb,firmware = &firmware_partition;

		/* buttons */
		pb,btn-back = &btn_back;
		pb,btn-up = &btn_up;
		pb,btn-center = &btn_center;
		pb,btn-down = &btn_down;

		/* watchdog */
		pb,wdt = &wdt0;
	};
};
