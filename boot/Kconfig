menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = PBLBOOT
module-str = pblboot
source "subsys/logging/Kconfig.template.log_config"

config PB_FLASH_READ_BUF_SIZE
	int "Flash read buffer size"
	default 512
	help
	  Size of the flash read buffer.

config PB_PRF_BUTTON_COMBO_TIME_MS
	int "PRF button combo time (ms)"
	default 5000
	help
	  Time in milliseconds that the PRF button combo must be held to trigger
	  a PRF load.

config PB_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	default 10000
	help
	  Timeout in milliseconds for the watchdog timer.

config PB_CHARGER
	bool "Enable charger support"
	default y
	help
	  Enable support for the battery charger.

config PB_FIRMWARE_NRF52
	bool "Boot fixed internal NRF52 firmware image"
	depends on SOC_SERIES_NRF52X
	help
	  Boot the firmware image directly from the internal-flash firmware
	  partition instead of selecting XIP slots from external flash.


config PB_FIRMWARE_NRF52_STAGED_UPDATE
	bool "Enable staged external-flash updates for NRF52 firmware"
	depends on PB_FIRMWARE_NRF52
	help
	  Validate pblboot-headered firmware images in external flash and copy
	  verified payloads into the fixed internal NRF52 firmware partition.
config PB_VBAT_MIN_BOOT_MV
	int "Minimal battery level to allow boot (mV)"
	default 3300
	depends on PB_CHARGER
	help
	  Minimal battery voltage in millivolts required to allow booting the
	  system. If watch is plugged in boot will be allowed regardless of
	  the battery voltage.
