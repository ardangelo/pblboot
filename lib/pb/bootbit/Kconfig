config PB_BOOTBIT
    bool "Boot bit library"
    help
      Enable the boot bit library.


if PB_BOOTBIT

module = PB_BOOTBIT
module-str = pb_bootbit
source "subsys/logging/Kconfig.template.log_config"

config PB_BOOTBIT_SF32LB
    bool "Boot bit SF32LB backend"
    default y if SOC_FAMILY_SF32
    depends on SOC_FAMILY_SF32
    help
      Enable boot bit SF32LB backend.

config PB_BOOTBIT_NRF52
    bool "Boot bit NRF52 retained RAM backend"
    default y if SOC_SERIES_NRF52X
    depends on SOC_SERIES_NRF52X
    help
      Enable boot bit NRF52 retained RAM backend.

endif # BOOTBIT
